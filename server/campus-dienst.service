# Campus-Dienst: Konten, Profile, Speichern. Kopieren nach /etc/systemd/system/
# Das geheime Proxy-Passwort steht in /etc/campus/dienst.env (siehe README, Server einrichten).
[Unit]
Description=Campus-Dienst (Konten und Speichern für die Campus-Website)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campus
Group=campus
Environment=CAMPUS_REPO=/srv/campus/repo
Environment=CAMPUS_DATEN=/var/lib/campus
Environment=CAMPUS_PORT=8090
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CAMPUS_ADMIN_GRUPPE=campus-admins
# Enthält CAMPUS_PROXY_GEHEIMNIS=..., gehört root und ist nur für root lesbar
EnvironmentFile=/etc/campus/dienst.env
ExecStart=/usr/bin/python3 /srv/campus/repo/server/dienst.py
# Beendet sich der Dienst nach einem Code-Update mit 75, startet systemd ihn neu
Restart=on-failure
RestartSec=2
UMask=0022
# Obergrenze für den Speicher, auch für die Skripte beim Schematic-Import
MemoryMax=1500M

# /var/lib/campus anlegen, nur für den Nutzer campus lesbar
StateDirectory=campus
StateDirectoryMode=0700

# Absichern: darf nur ins Repo und nach /var/lib/campus schreiben (dort liegt auch die Import-Vorschau)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/campus/repo /var/lib/campus
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
